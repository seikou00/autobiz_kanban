{
  "apiVersion": 1,
  "agentsRepo": {
    "url": "https://gitee.paas.cmbchina.cn/S992391/LF39_Product_Knowledge.git",
    "sshUrl": "git@gitee.itc.cmbchina.cn:S992391/LF39_Product_Knowledge.git",
    "ref": "master"
  },
  "knowledge_config": {
    "sync_type": "invoke_session",
    "nextAction": {
      "slashSkill": "knowledge-sync",
      "userMessage": "请针对${projectCode}项目发起知识沉淀，这个是 token：${leanToken}",
      "dialogTips": "发起知识沉淀"
    }
  },
  "supported_deploy_units": ["LA64.05_UEX", "LB47.05", "LA64.05"],
  "inspectCommands": {
    "darwin": {
      "knowledge_path": "${pluginPath}/sys",
      "project_status": "python3 ${pluginPath}/inspect_state.py --mode project --workspace ${pluginWorkspace} --projects ${projectDirs...}",
      "feature_status": "python3 ${pluginPath}/inspect_state.py --mode run --workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature}",
      "create_project": "python3 ${pluginPath}/hooks/init_workspace.py --mode createProject --workspace ${pluginWorkspace} --project ${projectDir}",
      "create_feature": "python3 ${pluginPath}/hooks/init_workspace.py --mode createFeature --workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --workflow-template ${workflowTemplate} --workflow-nodes ${workflowNodes} --selected-deployUnit ${selectedDeployUnits}",
      "system_prompt_inject": "\n- FEATURE_DIR：`${pluginWorkspace}/${projectDir}/.autobizdevops/features/${feature}`，这是当前 Feature 产物目录，不得自行定义特性/feature/slug 名称。\n- 调用 `${pluginPath}` 下的脚本时，execute/shell 工具请求省略 `cwd` 字段；状态和产物路径由环境变量或显式参数定位。",
      "plugin_dir_hook": "${pluginWorkspace}/${projectDir}",
      "dialog_tips": "**您正在开发${projectCode} 项目**\n请描述要新增或修改的特性，并说明验收标准。当前产物目录：`${pluginWorkspace}/${projectDir}`",
      "dynamic_workflow": "python3 ${pluginPath}/hooks/inspect_workflow_templates.py",
      "skip_node": "python3 ${pluginPath}/hooks/skip_node.py --plugin-workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --skip-node ${nodeId}",
      "pull_knowledge": "python3 ${pluginPath}/hooks/sync_agents.py --write-board-config",
      "session_context_inject": "python3 ${pluginPath}/hooks/render_collected_session_context.py --platform darwin --plugin-workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --selected-deployUnit ${selectedDeployUnits} --session-workspace-path ${sessionWorkspacePath} --knowledge-collector ${pluginPath}\\hooks\\collect-knowledge.js --knowledge-path ${pluginPath}/sys"
    },
    "linux": {
      "knowledge_path": "${pluginPath}/sys",
      "project_status": "python3 ${pluginPath}/inspect_state.py --mode project --workspace ${pluginWorkspace} --projects ${projectDirs...}",
      "feature_status": "python3 ${pluginPath}/inspect_state.py --mode run --workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature}",
      "create_project": "python3 ${pluginPath}/hooks/init_workspace.py --mode createProject --workspace ${pluginWorkspace} --project ${projectDir}",
      "create_feature": "python3 ${pluginPath}/hooks/init_workspace.py --mode createFeature --workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --workflow-template ${workflowTemplate} --workflow-nodes ${workflowNodes} --selected-deployUnit ${selectedDeployUnits}",
      "system_prompt_inject": "\n- FEATURE_DIR：`${pluginWorkspace}/${projectDir}/.autobizdevops/features/${feature}`，这是当前 Feature 产物目录，不得自行定义特性/feature/slug 名称。\n- 调用 `${pluginPath}` 下的脚本时，execute/shell 工具请求省略 `cwd` 字段；状态和产物路径由环境变量或显式参数定位。",
      "plugin_dir_hook": "${pluginWorkspace}/${projectDir}",
      "dialog_tips": "**您正在开发${projectCode} 项目**\n请描述要新增或修改的特性，并说明验收标准。当前产物目录：`${pluginWorkspace}/${projectDir}`",
      "dynamic_workflow": "python ${pluginPath}/hooks/inspect_workflow_templates.py",
      "skip_node": "python ${pluginPath}/hooks/skip_node.py --plugin-workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --skip-node ${nodeId}",
      "pull_knowledge": "python3 ${pluginPath}/hooks/sync_agents.py --write-board-config",
      "session_context_inject": "python3 ${pluginPath}/hooks/render_collected_session_context.py --platform linux --plugin-workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --selected-deployUnit ${selectedDeployUnits} --session-workspace-path ${sessionWorkspacePath} --knowledge-collector ${pluginPath}\\hooks\\collect-knowledge.js --knowledge-path ${pluginPath}/sys"
    },
    "win32": {
      "knowledge_path": "${pluginPath}\\sys",
      "project_status": "python ${pluginPath}\\inspect_state.py --mode project --workspace ${pluginWorkspace} --projects ${projectDirs...}",
      "feature_status": "python ${pluginPath}\\inspect_state.py --mode run --workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature}",
      "create_project": "python ${pluginPath}\\hooks\\init_workspace.py --mode createProject --workspace ${pluginWorkspace} --project ${projectDir}",
      "create_feature": "python ${pluginPath}\\hooks\\init_workspace.py --mode createFeature --workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --workflow-template ${workflowTemplate} --workflow-nodes ${workflowNodes} --selected-deployUnit ${selectedDeployUnits}",
      "system_prompt_inject": "\n- FEATURE_DIR：`${pluginWorkspace}\\${projectDir}\\.autobizdevops\\features\\${feature}`，这是当前 Feature 产物目录，不得自行定义特性/feature/slug 名称。\n- 调用 `${pluginPath}` 下的脚本时，execute/shell 工具请求省略 `cwd` 字段；状态和产物路径由环境变量或显式参数定位。",
      "plugin_dir_hook": "${pluginWorkspace}\\${projectDir}",
      "dialog_tips": "**您正在开发${projectCode} 项目**\n请描述要新增或修改的特性，并说明验收标准。当前产物目录：`${pluginWorkspace}/${projectDir}`",
      "dynamic_workflow": "python ${pluginPath}\\hooks\\inspect_workflow_templates.py",
      "skip_node": "python ${pluginPath}\\hooks\\skip_node.py --plugin-workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --skip-node ${nodeId}",
      "pull_knowledge": "python ${pluginPath}\\hooks\\sync_agents.py --write-board-config",
      "session_context_inject": "python ${pluginPath}\\hooks\\render_collected_session_context.py --platform win32 --plugin-workspace ${pluginWorkspace} --project ${projectDir} --feature ${feature} --selected-deployUnit ${selectedDeployUnits} --session-workspace-path ${sessionWorkspacePath} --knowledge-collector ${pluginPath}\\hooks\\collect-knowledge.js --knowledge-path ${pluginPath}\\sys"
    }
  },
  "workflow": {
    "skipPolicy": {
      "lockedNodes": []
    },
    "templates": {
      "standard": {
        "kind": "profile",
        "label": "标准",
        "description": "完整主干流程（Biz→Dev→Ops），不含可选动态节点；动态节点可在流程中按需开启。"
      },
      "lean": {
        "kind": "nodeSubset",
        "label": "精简路线",
        "description": "修接口 / 小需求：specs（轻量）→ code → 归档；契约不含 design/PLAN，code 直接从 proposal 与 specs 推导任务。",
        "nodes": ["dev.specs", "dev.code", "ops.archive"]
      }
    },
    "profiles": {
      "standard": {
        "label": "不需要，进入 autodev-specs",
        "description": "不先转换 HTML 设计稿，直接进入 autodev-specs。"
      },
      "frontend_before_specs": {
        "label": "需要，进入 HTML 转前端",
        "description": "先将 HTML 转换为项目内前端工程文件；在 autodev-frontend 内部按标准 HTML 或绝对定位高保真 HTML 分流，再进入后续阶段。",
        "nodes": [
          {
            "id": "dev.frontend",
            "phase": "Dev",
            "label": "前端实现",
            "skill": "autodev-frontend",
            "insertBefore": "dev.specs",
            "checkpointPrefix": "frontend",
            "description": "基于 PRD 与 HTML 进行前端实现，并在 autodev-frontend 内部按标准 HTML 或绝对定位高保真 HTML 分流 \n 产物：项目内前端工程文件（无独立文档产物）",
            "artifacts": {
              "inputs": [
                { "id": "prd", "label": "PRD文档", "artifactType": "file", "path": "PRD.md", "required": true,
                  "extract": {
                    "degrade": "无 PRD 时基于用户提供的 HTML 与描述实现，并记录验收基准缺失"
                  } }
              ],
              "outputs": []
            },
            "validators": []
          }
        ]
      }
    },
    "dynamicStages": [
      {
        "id": "detail_design_before_code",
        "phase": "Dev",
        "label": "详细设计",
        "description": "在进入代码实现前生成更细的文件级详细设计。",
        "order": 100,
        "choiceCheckpoint": "plan_done",
        "defaultDecision": "pending",
        "insertAfter": "dev.plan",
        "enableTargetCheckpoint": "detail_design_in_progress",
        "skipTargetCheckpoint": "code_in_progress",
        "enableLabel": "需要，生成详细设计",
        "skipLabel": "不需要，直接编码",
        "enableDescription": "先进入 autodev-detail-design，生成 DETAIL_DESIGN.md 后再进入代码实现。",
        "skipDescription": "不生成 DETAIL_DESIGN.md，直接进入 autodev-code。",
        "nodes": [
          {
            "id": "dev.detail_design",
            "phase": "Dev",
            "label": "详细设计",
            "skill": "autodev-detail-design",
            "checkpointPrefix": "detail_design",
            "description": "生成代码实现前的文件级详细设计 \n 产物：DETAIL_DESIGN.md（文件级详细设计：到文件的修改方案）",
            "artifacts": {
              "inputs": [
                { "id": "proposal", "label": "变更提案", "artifactType": "file", "path": "proposal.md", "required": true,
                  "extract": {
                    "degrade": "无 proposal 时以 specs 与 design 界定范围"
                  } },
                { "id": "specs", "label": "行为规格", "artifactType": "file", "path": "specs/**/*.md", "required": true,
                  "extract": {
                    "degrade": "无 specs 时与用户确认行为预期"
                  } },
                { "id": "design", "label": "技术设计", "artifactType": "file", "path": "design.md", "required": true,
                  "extract": {
                    "degrade": "无 design 时基于现有代码模式细化方案，并记录设计基准缺失"
                  } },
                { "id": "plan_json", "label": "计划机器事实源", "artifactType": "json", "path": "plan.json", "required": true,
                  "extract": {
                    "degrade": "无 plan.json 时回到 /autodev-plan 重新生成，不能只依赖 PLAN.md 推进详细设计"
                  } }
              ],
              "outputs": [
                { "id": "detail_design", "label": "详细设计", "artifactType": "file", "path": "DETAIL_DESIGN.md", "required": true }
              ]
            },
            "validators": []
          }
        ]
      }
    ],
    "checkpoints": {
      "initial": [
        "prd_in_progress",
        "specs_in_progress",
        "plan_in_progress",
        "cicd_in_progress"
      ],
      "transitions": {
        "prd_in_progress": ["prd_done"],
        "prd_done": ["specs_in_progress"],
        "specs_in_progress": ["specs_done"],
        "specs_done": ["plan_in_progress"],
        "plan_in_progress": ["plan_done"],
        "plan_done": ["code_in_progress"],
        "code_in_progress": ["code_done"],
        "code_done": ["requirements_eval_in_progress"],
        "requirements_eval_in_progress": ["requirements_eval_done"],
        "requirements_eval_done": ["unit_test_in_progress"],
        "unit_test_in_progress": ["unit_test_done", "needs_fix"],
        "unit_test_done": ["e2e_in_progress"],
        "e2e_in_progress": ["e2e_done", "needs_fix"],
        "e2e_done": ["verify_in_progress"],
        "verify_in_progress": ["verify_done", "needs_fix"],
        "verify_done": ["cicd_in_progress"],
        "cicd_in_progress": ["cicd_done"],
        "cicd_done": ["archived"],
        "needs_fix": [
          "prd_in_progress",
          "specs_in_progress",
          "plan_in_progress",
          "code_in_progress",
          "unit_test_in_progress",
          "cicd_in_progress"
        ],
        "archived": []
      },
      "stageLabels": {
        "prd_in_progress": "Biz / 需求澄清与 PRD",
        "prd_done": "Biz / PRD",
        "specs_in_progress": "Specs",
        "specs_done": "Specs 完成",
        "plan_in_progress": "Plan",
        "plan_done": "Plan 完成",
        "code_in_progress": "Code",
        "code_done": "Code 完成",
        "requirements_eval_in_progress": "Requirements Review",
        "requirements_eval_done": "Requirements Review 完成",
        "unit_test_in_progress": "Unit Test",
        "unit_test_done": "Unit Test 完成",
        "e2e_in_progress": "E2E",
        "e2e_done": "E2E 完成",
        "verify_in_progress": "Verify",
        "verify_done": "Verify 完成",
        "cicd_in_progress": "CI/CD",
        "cicd_done": "CI/CD 完成",
        "needs_fix": "需要修复",
        "archived": "已归档"
      }
    },
    "nodes": [
      {
        "id": "biz.prd",
        "label": "需求澄清与 PRD",
        "group": "Biz",
        "skill": "autobiz-requirement-discuss",
        "order": 10,
        "runtimePolicy": {
          "agentMode": "solo",
          "toolCustomConfig": {
            "task": {
              "enabled": false
            }
          }
        },
        "description": "澄清需求并生成正式 PRD 文档 \n 产物：PRD.md；存在外部资料时生成 sources/ 快照与 source-context.json",
        "states": [
          { "nodeStatus": "not_started", "label": "未开始", "nextAction": { "slashSkill": "autobiz-requirement-discuss", "userMessage": "请使用 /autobiz-requirement-discuss 继续推进当前 Feature。", "dialogTips": "当前阶段：需求澄清与 PRD。" } },
          { "nodeStatus": "in_progress", "label": "进行中", "nextAction": { "slashSkill": "autobiz-requirement-discuss", "userMessage": "请使用 /autobiz-requirement-discuss 继续推进当前 Feature。", "dialogTips": "当前阶段：需求澄清与 PRD。" } },
          { "nodeStatus": "done", "label": "已完成", "nextAction": { "slashSkill": "autodev-specs", "userMessage": "请使用 /autodev-specs 继续推进当前 Feature。", "dialogTips": "通过 /autodev-specs 路由到行为规格；是否需要先将 HTML 转换为项目内前端工程文件？需要则进入 autodev-frontend，并在该节点内按标准 HTML 或绝对定位高保真 HTML 分流；不需要则直接进入 autodev-specs 阶段。" } }
        ],
        "checkpoints": ["prd_in_progress", "prd_done"],
        "artifacts": {
          "inputs": [],
          "outputs": [
            { "id": "prd", "label": "PRD文档", "artifactType": "file", "path": "PRD.md", "required": true },
            { "id": "source_context", "label": "外部资料要求索引", "artifactType": "json", "path": "source-context.json", "required": false }
          ]
        },
        "validators": [],
        "hookDefinitions": [
          { "id": "biz-prd-validate", "label": "PRD 产物校验", "event": "PostSkillUse", "required": true }
        ]
      },
      {
        "id": "dev.specs",
        "label": "行为规格",
        "group": "Dev",
        "skill": "autodev-specs",
        "order": 30,
        "runtimePolicy": {
          "agentMode": "multi",
          "toolCustomConfig": {
            "task": {
              "enabled": true
            }
          },
           "subagentConfig": {
            "disabledBuiltinSubagents": ["Explore","critic"],
            "customSubagentFiles": ["agents/explore.md","agents/critic_autodev_zh.md","agents/specs-gate-fixer.md"]
          }
        },
        "description": "生成 proposal 与行为规格 \n 产物：proposal.md（变更提案：本轮目标、范围与非目标）、specs/**/*.md（行为规格：各能力 Requirement/Scenario 契约）",
        "states": [
          { "nodeStatus": "not_started", "label": "未开始", "nextAction": { "slashSkill": "autodev-specs", "userMessage": "请使用 /autodev-specs 继续推进当前 Feature。", "dialogTips": "当前阶段：行为规格。" } },
          { "nodeStatus": "in_progress", "label": "进行中", "nextAction": { "slashSkill": "autodev-specs", "userMessage": "请使用 /autodev-specs 继续推进当前 Feature。", "dialogTips": "当前阶段：行为规格。" } },
          { "nodeStatus": "done", "label": "已完成", "nextAction": { "slashSkill": "autodev-plan", "userMessage": "请使用 /autodev-plan 继续推进当前 Feature。", "dialogTips": "当前阶段：技术设计与计划。" } }
        ],
        "checkpoints": ["specs_in_progress", "specs_done"],
        "artifacts": {
          "inputs": [
            { "id": "prd", "label": "PRD文档", "artifactType": "file", "path": "PRD.md", "required": true,
              "extract": {
                "degrade": "无 PRD 时基于用户描述直接澄清行为契约，沉淀到 proposal 与 specs"
              } },
            { "id": "source_context_optional", "label": "外部资料要求索引", "artifactType": "json", "path": "source-context.json", "required": false,
              "extract": {
                "degrade": "无外部资料时跳过；存在时 targets 含 spec 的要求必须进入 Requirement 或 Scenario"
              } }
          ],
          "outputs": [
            { "id": "proposal", "label": "变更提案", "artifactType": "file", "path": "proposal.md", "required": true },
            { "id": "specs", "label": "行为规格", "artifactType": "file", "path": "specs/**/*.md", "required": true },
            { "id": "specs_review", "label": "规格回检结论", "artifactType": "file", "path": "SPECS_REVIEW.md", "required": true }
          ]
        },
        "validators": ["proposal_contract", "specs_contract", "capability_spec_correspondence", "specs_review_verdict"]
      },
      {
        "id": "dev.plan",
        "label": "技术设计与计划",
        "group": "Dev",
        "skill": "autodev-plan",
        "order": 40,
         "runtimePolicy": {
          "agentMode": "multi",
          "toolCustomConfig": {
            "task": {
              "enabled": true
            }
          },
          "subagentConfig": {
            "disabledBuiltinSubagents": ["Explore","critic"],
            "customSubagentFiles": ["agents/explore.md","agents/critic_autodev_plan_zh.md"]
          }
        },
        "description": "生成技术设计和执行计划 \n 产物：design.md（技术设计：API/数据/技术决策与模块边界）、PLAN.md（执行计划：任务 DAG 与各任务依据/验证/状态）",
        "states": [
          { "nodeStatus": "not_started", "label": "未开始", "nextAction": { "slashSkill": "autodev-plan", "userMessage": "请使用 /autodev-plan 继续推进当前 Feature。", "dialogTips": "当前阶段：技术设计与计划。" } },
          { "nodeStatus": "in_progress", "label": "进行中", "nextAction": { "slashSkill": "autodev-plan", "userMessage": "请使用 /autodev-plan 继续推进当前 Feature。", "dialogTips": "当前阶段：技术设计与计划。" } },
          { "nodeStatus": "done", "label": "已完成", "nextAction": { "slashSkill": "autodev-code", "userMessage": "请使用 /autodev-code 继续推进当前 Feature。", "dialogTips": "当前阶段：代码实现。如果需要code前的详细设计，可以先使用/autodev-detail-design生成详细设计方案。" } }
        ],
        "checkpoints": ["plan_in_progress", "plan_done"],
        "artifacts": {
          "inputs": [
            { "id": "proposal", "label": "变更提案", "artifactType": "file", "path": "proposal.md", "required": true,
              "extract": {
                "degrade": "无 proposal 时基于用户直供需求与代码探索建立上下文，并把边界假设记入 design.md 风险"
              } },
            { "id": "specs", "label": "行为规格", "artifactType": "file", "path": "specs/**/*.md", "required": true,
              "extract": {
                "degrade": "无 specs 时与用户确认行为预期后再设计，未确认行为全部记为待确认风险"
              } },
            { "id": "prd_optional", "label": "PRD外部资料索引", "artifactType": "file", "path": "PRD.md", "required": false,
              "extract": {
                "degrade": "无 PRD 时以 proposal/specs 设计；存在来源快照时以 source-context.json 与 sources/ 为准，只有从未取得资料时才阻断"
              } },
            { "id": "source_context_optional", "label": "外部资料要求索引", "artifactType": "json", "path": "source-context.json", "required": false,
              "extract": {
                "degrade": "无外部资料时跳过；存在时按 targets 写入 design，并把 plan/code 要求绑定到 task sourceRefs"
              } }
          ],
          "outputs": [
            { "id": "design", "label": "技术设计", "artifactType": "file", "path": "design.md", "required": true },
            { "id": "plan", "label": "执行计划", "artifactType": "file", "path": "PLAN.md", "required": true },
            { "id": "plan_json", "label": "计划机器结构化内容", "artifactType": "json", "path": "plan.json", "required": true }
          ]
        },
        "validators": ["design_contract", "plan_json_contract", "plan_json_initial_tasks", "plan_ref_resolution", "plan_task_granularity", "plan_scenario_coverage"],
        "rollback": {
          "archive": ["plans"]
        }
      },
      {
        "id": "dev.code",
        "label": "代码实现",
        "group": "Dev",
        "skill": "autodev-code",
        "order": 50,
        "runtimePolicy": {
          "agentMode": "multi",
          "toolCustomConfig": {
            "task": {
              "enabled": true
            }
          },
          "subagentConfig": {
            "disabledBuiltinSubagents": ["Explore","code-reviewer","code-simplifier","verification"],
            "customSubagentFiles": ["agents/explore.md","agents/code-reviewer.md","agents/code-simplifier.md","agents/verification.md"]
          }
        },
