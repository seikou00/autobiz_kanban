{
  "PreToolUse": [
    {
      "matcher": "task|Task",
      "hooks": [
        {
          "type": "command",
          "command": "python3 hooks/augment_explore_task_prompt.py",
          "timeout": 30,
          "persistAfterInterrupt": true
        },
        {
          "type": "command",
          "command": "python3 hooks/augment_test_engineer_task_prompt.py",
          "timeout": 30,
          "persistAfterInterrupt": true
        }
      ]
    },
    {
      "matcher": "write_file|edit_file",
      "hooks": [
        {
          "type": "command",
          "command": "python hooks/state_checkpoint.py state-done",
          "timeout": 300,
          "onBlock": {
            "reason": "state检查不通过",
            "systemMessage": "非法的路径转移",
            "additionalContext": "停止任务，询问用户行为"
          },
          "persistAfterInterrupt": true
        },
        {
          "type": "command",
          "command": "python hooks/state_checkpoint.py autodev-lifecycle",
          "timeout": 300,
          "onBlock": {
            "reason": "产物检查不通过",
            "systemMessage": "缺少产物",
            "additionalContext": "停止任务，补充产物"
          },
          "persistAfterInterrupt": true

        },
        {
          "type": "command",
          "command": "python hooks/check-secrets-new.py",
          "timeout": 1000,
          "persistAfterInterrupt": true
        }
      ]
    },
    {
      "matcher": "read_file",
      "hooks": [
        {
          "type": "command",
          "command": "python hooks/check_state_read.py",
          "timeout": 300,
          "persistAfterInterrupt": true
        }
      ]
    },
    {
      "matcher":"execute",
      "hooks":[
        {
          "type": "command",
          "command": "python hooks/performance_checker.py",
          "timeout": 7200,
          "persistAfterInterrupt": true
        },
        {
          "type": "command",
          "command": "python hooks/check_state_read.py",
          "timeout": 300,
          "persistAfterInterrupt": true
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "execute",
      "hooks": [
        {
          "type": "command",
          "command": "python hooks/artifact_sync_execute_hook.py",
          "timeout": 120,
          "persistAfterInterrupt": true
        }
      ]
    }
  ]
}
