{
  "PreToolUse": [
    {
      "matcher": "read_file",
      "hooks": [
        {
          "type": "command",
          "command": "python hooks/check_plugin_read.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "write_file|edit_file",
      "hooks": [
        {
          "type": "command",
          "command": "python hooks/state_checkpoint.py state-done",
          "timeout": 300,
          "onBlock": {
            "reason": "state检查不通过",
            "systemMessage": "非法的路径转移",
            "additionalContext": "停止任务，询问用户行为"
          },
          "persistAfterInterrupt": true
        },
        {
          "type": "command",
          "command": "python hooks/state_checkpoint.py autodev-lifecycle",
          "timeout": 300,
          "onBlock": {
            "reason": "产物检查不通过",
            "systemMessage": "缺少产物",
            "additionalContext": "停止任务，补充产物"
          },
          "persistAfterInterrupt": true

        }
      ]
    },
    {
      "matcher": "execute",
      "hooks": [
        {
          "type": "command",
          "command": "python hooks/code_done_compile_guard.py",
          "timeout": 3600,
          "onBlock": {
            "reason": "code_done 前模块编译不通过",
            "systemMessage": "停止推进 code_done。请修复模块编译错误后重试。",
            "additionalContext": "模块编译清单应位于 PLUGIN_WORKSPACE/PROJECT_CODE/.autobizdevops/modules_compile.json。"
          },
          "persistAfterInterrupt": true
        }
      ]
    }
  ]
}
