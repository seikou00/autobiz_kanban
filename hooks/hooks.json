{
  "PreToolUse": [
    {
      "matcher": "write_file|edit_file",
      "hooks": [
        {
          "type": "command",
          "command": "python hooks/state_checkpoint.py state-done",
          "timeout": 300,
          "onBlock": {
            "reason": "state检查不通过",
            "systemMessage": "非法的路径转移",
            "additionalContext": "停止任务，询问用户行为"
          },
          "persistAfterInterrupt": true
        },
        {
          "type": "command",
          "command": "python hooks/state_checkpoint.py autodev-lifecycle",
          "timeout": 300,
          "onBlock": {
            "reason": "产物检查不通过",
            "systemMessage": "缺少产物",
            "additionalContext": "停止任务，补充产物"
          },
          "persistAfterInterrupt": true

        },
        {
          "type": "command",
          "command": "python hooks/frontend_route_write_guard.py",
          "timeout": 10,
          "onBlock": {
            "reason": "前端 Route 检查不通过",
            "systemMessage": "前端代码生成必须先解析 FRONTEND_ROUTE.json；HTML 路线需完成 route SKILL.md 的 write_todos 前置流程，spec-driven-ui 不需要 HTML parser。",
            "additionalContext": "运行 resolve_frontend_html_route.py。absolute-html/standard-html 路线需完整读取 route SKILL.md、创建 route todos 并由 route SKILL 转交 parser；spec-driven-ui 按 UI_CONTEXT.json、specs、design 和 plan.json 直接实现。"
          },
          "persistAfterInterrupt": true
        },
        {
          "type": "command",
          "command": "python hooks/check-secrets-new.py",
          "timeout": 1000,
          "persistAfterInterrupt": true
        }
      ]
    },
    {
      "matcher":"execute",
      "hooks":[
        {
          "type": "command",
          "command": "python hooks/performance_checker.py",
          "timeout": 7200,
          "persistAfterInterrupt": true
        }
      ]
    }
  ]
}
