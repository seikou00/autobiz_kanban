{
  "PreToolUse": [
    {
      "matcher": "read_file",
      "hooks": [
        {
          "type": "command",
          "command": "python hooks/check_plugin_read.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "write_file|edit_file",
      "hooks": [
        {
          "type": "command",
          "command": "python hooks/state_checkpoint.py state-done",
          "timeout": 300,
          "onBlock": {
            "reason": "state检查不通过",
            "systemMessage": "非法的路径转移",
            "additionalContext": "停止任务，询问用户行为"
          },
          "persistAfterInterrupt": true
        },
        {
          "type": "command",
          "command": "python hooks/state_checkpoint.py autodev-lifecycle",
          "timeout": 300,
          "onBlock": {
            "reason": "产物检查不通过",
            "systemMessage": "缺少产物",
            "additionalContext": "停止任务，补充产物"
          },
          "persistAfterInterrupt": true

        }
      ]
    },
    {
      "matcher": "execute",
      "hooks": [
        {
          "type": "command",
          "command": "python hooks/code_done_compile_guard.py",
          "timeout": 7200,
          "onBlock": {
            "reason": "状态脚本参数不合法",
            "systemMessage": "停止执行状态脚本。请删除 --workspace/-w，由插件环境决定状态路径。",
            "additionalContext": "code_done 编译由 execute hook 非阻塞执行，模块编译清单应位于 PLUGIN_WORKSPACE/PROJECT_CODE/.autobizdevops/modules_compile.json。"
          },
          "persistAfterInterrupt": true
        }
      ]
    }
  ]
}
