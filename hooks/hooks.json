{
  "PreToolUse": [
    {
      "matcher": "write_file|edit_file",
      "hooks": [
        {
          "type": "command",
          "command": "python hooks/state_checkpoint.py state-done",
          "timeout": 300,
          "onBlock": {
            "reason": "state检查不通过",
            "systemMessage": "非法的路径转移",
            "additionalContext": "停止任务，询问用户行为"
          },
          "persistAfterInterrupt": true
        },
        {
          "type": "command",
          "command": "python hooks/state_checkpoint.py autodev-lifecycle",
          "timeout": 300,
          "onBlock": {
            "reason": "产物检查不通过",
            "systemMessage": "缺少产物",
            "additionalContext": "停止任务，补充产物"
          },
          "persistAfterInterrupt": true

        },
        {
          "type": "command",
          "command": "python hooks/check-secrets-new.py",
          "timeout": 1000,
          "persistAfterInterrupt": true
        }
      ]
    },
    {
      "matcher": "read_file",
      "hooks": [
        {
          "type": "command",
          "command": "python hooks/check_hook_log_read.py",
          "timeout": 300,
          "onBlock": {
            "reason": "hooks.ndjson 不是状态源",
            "systemMessage": "改用 read_state_json.py 读取当前 checkpoint",
            "additionalContext": "hooks.ndjson 是 hook 审计日志，当前 checkpoint 只以 state.json 为准"
          },
          "persistAfterInterrupt": true
        }
      ]
    },
    {
      "matcher":"execute",
      "hooks":[
        {
          "type": "command",
          "command": "python hooks/performance_checker.py",
          "timeout": 7200,
          "persistAfterInterrupt": true
        },
        {
          "type": "command",
          "command": "python hooks/check_hook_log_read.py",
          "timeout": 300,
          "onBlock": {
            "reason": "hooks.ndjson 不是状态源",
            "systemMessage": "改用 read_state_json.py 读取当前 checkpoint",
            "additionalContext": "hooks.ndjson 是 hook 审计日志，当前 checkpoint 只以 state.json 为准"
          },
          "persistAfterInterrupt": true
        }
      ]
    }
  ]
}
